# Keep Unity text assets mergeable and normalize line endings.
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

